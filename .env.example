# Backend API URL (required)
# Must include protocol: http://localhost:8000 or https://your-api.onrender.com
PUBLIC_API_BASE_URL=http://localhost:8000

# Site URL (optional, defaults to https://prayerwall.space)
# SITE=https://prayerwall.space

# Server host/port (optional, defaults to 0.0.0.0:4321)
# HOST=0.0.0.0
# PORT=4321
