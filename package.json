{
  "name": "prayer-wall-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepare": "husky",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "lint-staged": {
    "*.{astro,svelte,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/node": "^11.0.0",
    "@astrojs/svelte": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.0.3",
    "lucide-astro": "^0.556.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.18.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "serve": "^14.2.6",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.113.0"
  }
}
