---
import BaseLayout from "@/components/BaseLayout.astro";
import PrayerActions from "@/components/PrayerActions.svelte";
import PrayerForm from "@/components/PrayerForm.svelte";
import ErrorState from "@/components/ui/ErrorState.astro";
import Badge from "@/components/ui/Badge.astro";
import { ApiClient } from "@/lib/api/client";
import { getPrayer, listPrayersForRequest } from "@/lib/api/prayers";
import { formatDateTime, identityLabel, identityKind } from "@/lib/utils/format";
import { SITE_URL } from "@/lib/config";
import type { Prayer, PrayerRequest } from "@/lib/types";

const session = Astro.locals.session;
const client = new ApiClient(session);
const prayerId = Astro.params.id!;

let prayer: PrayerRequest | null = null;
let activity: Prayer[] = [];
let forbidden = "";
let notFound = "";

try {
  prayer = await getPrayer(client, prayerId);
  try {
    const result = await listPrayersForRequest(client, prayerId);
    activity = result.results;
  } catch {
    activity = [];
  }
} catch (error: any) {
  if (error.status === 403) forbidden = error.detail || "This request is private.";
  else if (error.status === 404) notFound = "This prayer request no longer exists.";
  else forbidden = error.detail || "Unable to load this request.";
}

const isOwner =
  Boolean(prayer && session.user?.id && prayer.user === session.user.id) ||
  Boolean(prayer && session.anonymous?.id && prayer.anonymous_user === session.anonymous?.id);
const canEdit = Boolean(prayer && (isOwner || session.isAdmin));
const canDelete = Boolean(prayer && (isOwner || session.isAdmin));
const alreadyPrayed = Boolean(
  activity.find((item) => item.user === session.user?.id || item.anonymous_user === session.anonymous?.id),
);
---

<BaseLayout
  title={prayer ? (prayer.title || prayer.description.substring(0, 80) + "...") : "Prayer Request"}
  description={prayer ? prayer.description.substring(0, 200) : "Prayer request details"}
  ogType="article"
  robots={prayer && !prayer.is_public ? "noindex, nofollow" : undefined}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Prayers", href: "/prayers" },
    { name: prayer ? (prayer.title || "Prayer Request") : "Prayer Request" },
  ]}
>
  {prayer && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: prayer.title || prayer.description.substring(0, 120),
      description: prayer.description.substring(0, 300),
      author: prayer.user_detail
        ? { "@type": "Person", name: [prayer.user_detail.first_name, prayer.user_detail.last_name].filter(Boolean).join(" ") || prayer.user_detail.email }
        : { "@type": "Person", name: prayer.anonymous_user_detail?.display_name || "Anonymous" },
      datePublished: prayer.created_at,
      dateModified: prayer.updated_at,
      commentCount: prayer.prayer_count,
      url: `${SITE_URL}/prayers/${prayer.id}`,
      mainEntityOfPage: `${SITE_URL}/prayers/${prayer.id}`,
    })}></script>
  )}

  {notFound ? (
    <ErrorState title="Not found" message={notFound} actionHref="/prayers" actionLabel="Back to prayers" />
  ) : forbidden ? (
    <ErrorState title="Access restricted" message={forbidden} actionHref="/auth/login" actionLabel="Log in" />
  ) : prayer ? (
    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
      <section class="min-w-0 space-y-6">
        {/* Back link */}
        <a href="/prayers" class="inline-flex items-center gap-1.5 text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          Back to prayers
        </a>

        {/* Main content */}
        <div class="card p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {isOwner && <Badge tone="accent">Your request</Badge>}
            {!isOwner && session.isAdmin && <Badge tone="neutral">Admin</Badge>}
            <Badge tone={prayer.is_public ? "success" : "warning"}>
              {prayer.is_public ? "Public" : "Private"}
            </Badge>
            <Badge tone={identityKind(prayer) === "anonymous" ? "info" : "neutral"}>
              {identityLabel(prayer)}
            </Badge>
          </div>

          <h1 class="heading-display text-2xl sm:text-3xl text-(--color-text)">{prayer.title}</h1>

          {prayer.tags && prayer.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {prayer.tags.map((tag) => (
                <span class="rounded-full bg-[color-mix(in_srgb,var(--color-primary)_6%,var(--color-surface))] px-3 py-1 text-xs font-medium text-(--color-primary) border border-[color-mix(in_srgb,var(--color-primary)_10%,var(--color-line))]">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <div class="mt-5">
            <p class="whitespace-pre-wrap text-[1rem] leading-7 sm:text-[1.05rem]">{prayer.description}</p>
          </div>

          <div class="mt-6 flex flex-wrap gap-3 border-t border-(--color-line-light) pt-4 text-xs text-(--color-text-muted)">
            <span class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              Created {formatDateTime(prayer.created_at)}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              {prayer.prayer_count} prayers
            </span>
          </div>
        </div>

        {/* Edit form */}
        {canEdit && (
          <div class="card p-6">
            <h2 class="heading-serif text-lg font-semibold text-(--color-text) mb-4">Edit Request</h2>
            <PrayerForm
              prayerId={prayer.id}
              initialDescription={prayer.description}
              initialIsPublic={prayer.is_public}
              initialTitle={prayer.title}
              mode="edit"
              submitLabel="Save changes"
              redirectTo={`/prayers/${prayer.id}`}
              client:load
            />
          </div>
        )}

        {/* Prayer history */}
        <div class="card p-6">
          <div class="flex items-center justify-between gap-3 mb-5">
            <h2 class="heading-serif text-lg font-semibold text-(--color-text)">Prayer History</h2>
            <Badge tone={alreadyPrayed ? "success" : "neutral"}>
              {alreadyPrayed ? "You prayed" : "Not prayed yet"}
            </Badge>
          </div>

          {activity.length > 0 ? (
            <ol class="space-y-3">
              {activity.map((entry) => (
                <li class="flex items-center gap-3 rounded-xl border border-(--color-line-light) px-4 py-3 bg-(--color-bg-elevated)">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[color-mix(in_srgb,var(--color-primary)_8%,var(--color-surface))] text-xs font-medium text-(--color-primary)">
                    {entry.user_detail
                      ? [entry.user_detail.first_name, entry.user_detail.last_name].filter(Boolean).join("").charAt(0).toUpperCase() || entry.user_detail.email.charAt(0).toUpperCase()
                      : entry.anonymous_user_detail?.display_name?.charAt(0).toUpperCase() || "A"}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-(--color-text) truncate">
                      {entry.user_detail
                        ? [entry.user_detail.first_name, entry.user_detail.last_name].filter(Boolean).join(" ") || entry.user_detail.email
                        : entry.anonymous_user_detail?.display_name || "Anonymous"}
                    </p>
                    <p class="text-xs text-(--color-text-muted)">{formatDateTime(entry.created_at || "")}</p>
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="text-sm text-(--color-text-muted) py-8 text-center">No prayer entries for this request yet.</p>
          )}
        </div>
      </section>

      {/* Sidebar */}
      <aside class="space-y-4 xl:sticky xl:top-24 self-start">
        <div class="card p-5">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-(--color-text-muted) mb-3">Actions</h3>
          <PrayerActions
            prayerId={prayer.id}
            initialCount={prayer.prayer_count}
            alreadyPrayed={alreadyPrayed}
            canDelete={canDelete}
            client:load
          />
        </div>
      </aside>
    </div>
  ) : (
    <ErrorState title="Unable to load" message="The request could not be loaded." actionHref="/prayers" actionLabel="Back to prayers" />
  )}
</BaseLayout>
