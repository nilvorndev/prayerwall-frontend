---
import BaseLayout from "@/components/BaseLayout.astro";
---

<BaseLayout
  title="Donate"
  description="Support the Prayer Wall project maintainer, help us keep this platform up, private, and available to everyone."
  breadcrumbs={[{ name: "Home", href: "/" }, { name: "Donate" }]}
>
  <div class="space-y-12">
    {/* Hero */}
    <section class="relative pt-4 md:pt-8">
      <div class="absolute inset-x-0 -top-20 flex justify-center pointer-events-none">
        <div class="h-[24rem] w-[36rem] rounded-full opacity-15 blur-[100px] bg-(--color-accent)"></div>
      </div>
      <div class="relative mx-auto max-w-2xl text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-accent)_15%,var(--color-line))] bg-[color-mix(in_srgb,var(--color-accent)_5%,var(--color-bg-elevated))] px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-(--color-accent-dark)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
            ></path>
          </svg>
          Support Prayer Wall
        </span>

        <h1 class="heading-display mt-6 text-3xl sm:text-4xl md:text-5xl text-(--color-text)">
          Help Us Keep Prayer Wall{" "}
          <span class="text-(--color-accent-dark)">Free &amp; Open</span>
        </h1>

        <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-(--color-text-secondary) md:text-base">
          Your generosity keeps Prayer Wall running, a free, private space where anyone can share and pray for requests
          without ads, tracking, or paywalls.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="#other-ways" class="btn btn-primary btn-lg gap-2.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
              ></path>
            </svg>
            See Donation Options
          </a>
          <a href="#other-ways" class="btn btn-outline btn-lg"> Other Ways to Give </a>
        </div>

        <div class="mt-6 flex items-center justify-center gap-6 text-xs text-(--color-text-muted)">
          <span class="inline-flex items-center gap-1.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-(--color-success)"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            No ads or tracking
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-(--color-success)"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            100% community funded
          </span>
        </div>
      </div>
    </section>

    {/* Not in a Position to Donate? */}
    <section class="card card-featured card-interactive p-8 md:p-10 text-center relative overflow-hidden">
      <div
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-(--color-accent) to-transparent opacity-60"
      >
      </div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="heading-display text-2xl md:text-3xl text-(--color-text)">Not in a Position to Donate?</h2>
        <p class="mt-4 text-sm leading-7 text-(--color-text-secondary) md:text-base">
          You can still make a difference. Share Prayer Wall with your community, pray for this ministry, or reach out
          if you have skills in development, design, or writing that could help.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/prayers" class="btn btn-outline btn-sm">Browse prayer requests</a>
          <a href="/prayers/create" class="btn btn-outline btn-sm">Submit a request</a>
          <a href="mailto:hello@prayerwall.space" class="btn btn-outline btn-sm">Get in touch</a>
        </div>
      </div>
    </section>

    {/* Prayer Message */}
    <section class="text-center py-4">
      <p
        class="text-2xl sm:text-3xl md:text-4xl text-(--color-accent-dark) font-bold"
        style="letter-spacing: 0.02em; word-spacing: 0.05em;"
      >
        Don't forget, your prayer is the biggest support for us
      </p>
    </section>

    {/* Other Ways to Give */}
    <section id="other-ways">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--color-primary)">More Options</p>
        <h2 class="heading-display mt-3 text-3xl text-(--color-text)">Other Ways to Give</h2>
        <p class="mt-3 text-sm leading-7 text-(--color-text-secondary)">
          Prefer a different platform? Choose whichever is easiest for you.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5 stagger">
        <a
          href="mailto:hello@prayerwall.space"
          class="card card-interactive p-6 sm:col-span-2 flex flex-col sm:flex-row items-start sm:items-center gap-4 group"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-(--color-success)/10 text-(--color-success)"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-semibold text-(--color-text) group-hover:text-(--color-primary) transition-colors">
              Money Transfer &amp; Bank
            </p>
            <p class="text-xs text-(--color-text-muted)">
              Western Union, Ria, MoneyGram, bank transfer &mdash; contact us for recipient details
            </p>
          </div>
        </a>

        <a
          href="buymeacoffee.com/omid369"
          target="_blank"
          rel="noopener noreferrer"
          class="card card-interactive p-5 flex items-center gap-4 group"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#FFDD00]/15 text-[#FF813A]">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
              <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
              <line x1="6" y1="2" x2="6" y2="4"></line>
              <line x1="10" y1="2" x2="10" y2="4"></line>
              <line x1="14" y1="2" x2="14" y2="4"></line>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-semibold text-(--color-text) group-hover:text-(--color-primary) transition-colors">
              Buy Me a Coffee
            </p>
            <p class="text-xs text-(--color-text-muted)">Quick, simple donation</p>
          </div>
        </a>

        <a
          href="https://ko-fi.com/omid369/goal?g=1"
          target="_blank"
          rel="noopener noreferrer"
          class="card card-interactive p-5 flex items-center gap-4 group"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#FF5E5B]/10 text-[#FF5E5B]">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.616 2.658-3.726l.03-10.841c-.01-1.234-.629-2.463-2.297-2.623z"
              ></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-semibold text-(--color-text) group-hover:text-(--color-primary) transition-colors">Ko-fi</p>
            <p class="text-xs text-(--color-text-muted)">No fees on donations</p>
          </div>
        </a>

        <a href="mailto:hello@prayerwall.space" class="card card-interactive p-5 flex items-center gap-4 group">
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-(--color-info)/10 text-(--color-info)"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-semibold text-(--color-text) group-hover:text-(--color-primary) transition-colors">Crypto</p>
            <p class="text-xs text-(--color-text-muted)">BTC, ETH accepted</p>
          </div>
        </a>
      </div>
    </section>

    {/* Where Your Donation Goes */}
    <section>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--color-primary)">Transparency</p>
        <h2 class="heading-display mt-3 text-3xl text-(--color-text)">Where Your Donation Goes</h2>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 stagger">
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--color-primary)_8%,var(--color-surface))] text-(--color-primary)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </span>
            <div>
              <p class="font-semibold text-(--color-text)">Servers &amp; Infrastructure</p>
              <p class="text-2xl font-bold text-(--color-primary)">40%</p>
            </div>
          </div>
          <p class="mt-3 text-sm leading-6 text-(--color-text-secondary)">
            Hosting, databases, SSL certificates, CDN, email delivery, and monitoring tools that keep Prayer Wall fast,
            secure, and always available.
          </p>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--color-accent)_8%,var(--color-surface))] text-(--color-accent-dark)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </span>
            <div>
              <p class="font-semibold text-(--color-text)">Development</p>
              <p class="text-2xl font-bold text-(--color-accent-dark)">30%</p>
            </div>
          </div>
          <p class="mt-3 text-sm leading-6 text-(--color-text-secondary)">
            New features, bug fixes, security updates, and performance improvements. Every donation directly funds the
            next release.
          </p>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--color-success)_8%,var(--color-surface))] text-(--color-success)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div>
              <p class="font-semibold text-(--color-text)">Community &amp; Outreach</p>
              <p class="text-2xl font-bold text-(--color-success)">20%</p>
            </div>
          </div>
          <p class="mt-3 text-sm leading-6 text-(--color-text-secondary)">
            Moderation, support, documentation, and community building to ensure Prayer Wall remains a safe and
            welcoming space.
          </p>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--color-info)_8%,var(--color-surface))] text-(--color-info)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 6v6l4 2"></path>
              </svg>
            </span>
            <div>
              <p class="font-semibold text-(--color-text)">Reserve Fund</p>
              <p class="text-2xl font-bold text-(--color-info)">10%</p>
            </div>
          </div>
          <p class="mt-3 text-sm leading-6 text-(--color-text-secondary)">
            Saved for emergencies, unexpected costs, and future growth. We plan for the long term to keep Prayer Wall
            sustainable.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
