---
import "../styles/global.css";
import Navigation from "./Navigation.astro";
import { SITE_URL } from "@/lib/config";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  robots?: string;
  breadcrumbs?: Array<{ name: string; href?: string }>;
}

const { title, description, image, ogType = "website", robots, breadcrumbs } = Astro.props;
const siteUrl = SITE_URL;
const canonical = Astro.url.origin + Astro.url.pathname;
const pageTitle = `${title} | Prayer Wall`;
const pageImage = image || "/og-image.png";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#FAFAF8" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Prayer Wall" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}${pageImage}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@prayerwall" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={`${siteUrl}${pageImage}`} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Prayer Wall",
        url: siteUrl,
        description: "A private and anonymous prayer platform. Share your prayer requests and pray for others.",
        potentialAction: {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: `${siteUrl}/prayers?search={search_term_string}`,
          },
          "query-input": "required name=search_term_string",
        },
      })}
    />

    {
      breadcrumbs && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: breadcrumbs.map((item, i) => ({
              "@type": "ListItem",
              position: i + 1,
              name: item.name,
              ...(item.href ? { item: `${siteUrl}${item.href}` } : {}),
            })),
          })}
        />
      )
    }

    <link rel="alternate" type="application/rss+xml" title="Prayer Wall RSS Feed" href={`${siteUrl}/rss.xml`} />

    <slot name="head" />

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      />
    </noscript>
  </head>
  <body class="min-h-screen bg-(--color-bg) text-(--color-text)">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] rounded-lg bg-(--color-primary) px-4 py-2 text-sm font-medium text-white"
    >
      Skip to content
    </a>

    <Navigation />

    <main id="content" class="mx-auto w-full max-w-[72rem] px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="border-t border-(--color-line) bg-(--color-surface)">
      <div class="mx-auto max-w-[72rem] px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          <div class="col-span-2 md:col-span-1">
            <a href="/" class="flex items-center gap-2.5">
              <img src="/logo.png" alt="Prayer Wall" class="h-9 w-9 object-contain" />
              <span class="text-sm font-semibold text-(--color-text)">Prayer Wall</span>
            </a>
            <p class="mt-3 text-sm leading-6 text-(--color-text-secondary)">
              A private prayer platform. Share your prayer requests and pray for others.
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-(--color-text)">Prayer Requests</p>
            <ul class="mt-3 space-y-2.5">
              <li>
                <a
                  href="/prayers"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors"
                  >Browse requests</a
                >
              </li>
              <li>
                <a
                  href="/prayers/create"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors"
                  >Submit a request</a
                >
              </li>
            </ul>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-(--color-text)">Account</p>
            <ul class="mt-3 space-y-2.5">
              <li>
                <a
                  href="/auth/login"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">Log in</a
                >
              </li>
              <li>
                <a
                  href="/auth/register"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors"
                  >Create account</a
                >
              </li>
              <li>
                <a
                  href="/donate"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">Donate</a
                >
              </li>
            </ul>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-(--color-text)">Legal</p>
            <ul class="mt-3 space-y-2.5">
              <li>
                <a
                  href="/terms"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">Terms</a
                >
              </li>
              <li>
                <a
                  href="/privacy"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">Privacy</a
                >
              </li>
              <li>
                <a
                  href="/rss.xml"
                  class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">RSS Feed</a
                >
              </li>
            </ul>
          </div>
        </div>

        <div
          class="mt-10 border-t border-(--color-line) pt-6 flex flex-col items-center justify-between gap-2 text-xs text-(--color-text-muted) sm:flex-row"
        >
          <p>&copy; {new Date().getFullYear()} Prayer Wall. All rights reserved.</p>
          <p>Built with faith and care.</p>
        </div>
      </div>
    </footer>

    <script>
      const stored = localStorage.getItem("pw-theme");
      const preferredDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = stored === "dark" || stored === "light" ? stored : preferredDark ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", theme);
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", theme === "dark" ? "#0F172A" : "#FAFAF8");
    </script>
  </body>
</html>
