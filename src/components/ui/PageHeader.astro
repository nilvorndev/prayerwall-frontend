---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className = "" } = Astro.props;
---

<div class:list={["mb-6", className]}>
  {eyebrow && (
    <p class="text-xs font-semibold uppercase tracking-widest text-(--color-primary) mb-2">{eyebrow}</p>
  )}
  <h1 class="heading-display text-3xl sm:text-4xl text-(--color-text)">{title}</h1>
  {description && (
    <p class="mt-2 text-base text-(--color-text-secondary) max-w-2xl">{description}</p>
  )}
  <div class="mt-4">
    <slot name="actions" />
  </div>
</div>
