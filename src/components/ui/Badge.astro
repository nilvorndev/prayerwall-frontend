---
export interface Props {
  tone?: "neutral" | "accent" | "success" | "warning" | "danger" | "info";
  subtle?: boolean;
  class?: string;
}

const { tone = "neutral", subtle = true, class: className = "" } = Astro.props;

const toneStyles: Record<string, string> = {
  neutral: subtle
    ? "bg-(--color-surface) text-(--color-text-secondary) border-(--color-line)"
    : "bg-(--color-text-secondary) text-white",
  accent: subtle
    ? "bg-[color-mix(in_srgb,var(--color-primary)_8%,var(--color-bg-elevated))] text-(--color-primary) border-[color-mix(in_srgb,var(--color-primary)_15%,var(--color-line))]"
    : "bg-(--color-primary) text-white",
  success: subtle
    ? "bg-(--color-success-light) text-(--color-success) border-[color-mix(in_srgb,var(--color-success)_15%,var(--color-line))]"
    : "bg-(--color-success) text-white",
  warning: subtle
    ? "bg-(--color-warning-light) text-(--color-warning) border-[color-mix(in_srgb,var(--color-warning)_15%,var(--color-line))]"
    : "bg-(--color-warning) text-white",
  danger: subtle
    ? "bg-(--color-danger-light) text-(--color-danger) border-[color-mix(in_srgb,var(--color-danger)_15%,var(--color-line))]"
    : "bg-(--color-danger) text-white",
  info: subtle
    ? "bg-(--color-info-light) text-(--color-info) border-[color-mix(in_srgb,var(--color-info)_15%,var(--color-line))]"
    : "bg-(--color-info) text-white",
};
---

<span class:list={[
  "badge border",
  toneStyles[tone],
  className,
]}>
  <slot />
</span>
